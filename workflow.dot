digraph mastr_pipeline {
    rankdir=TB;
    graph [splines=ortho, nodesep=0.6, ranksep=0.8, bgcolor=transparent];
    node [fontname="Helvetica", fontsize=11, margin="0.2,0.1"];
    edge [fontname="Helvetica", fontsize=9];

    // ── Data Source ──
    SMARD [label="SMARD API (BNetzA)\nJSON · 15-min intervals · 15 categories",
           shape=folder, style=filled, fillcolor="#FFF3CD", color="#B8860B"];

    // ── Ingestion ──
    Ingestion [label="Python Ingestion\nget_data.py · API fetch · weekly files",
               shape=box, style="filled,rounded", fillcolor="#D5F5E3", color="#1E8449"];

    // ── Storage Layers ──
    GCS_Raw [label="GCS Raw Layer\nJSON Files",
             shape=cylinder, style=filled, fillcolor="#D6EAF8", color="#2E86C1"];

    GCS_Processed [label="GCS Processed Layer\nParquet · partitioned year/month",
                   shape=cylinder, style=filled, fillcolor="#D6EAF8", color="#2E86C1"];

    // ── Processing ──
    Spark [label="PySpark\nExplode · Map categories · Partition",
           shape=box, style="filled,rounded", fillcolor="#D5F5E3", color="#1E8449"];

    // ── Warehouse ──
    BigQuery [label="BigQuery\nPartitioned + Clustered Table",
              shape=box, style="filled,rounded", fillcolor="#E8DAEF", color="#7D3C98"];

    // ── Transformation ──
    dbt [label="dbt\nstg_energy_data → fct_renewable_share\nmrt_daily_energy_stats · mrt_hourly_patterns",
         shape=box, style="filled,rounded", fillcolor="#D5F5E3", color="#1E8449"];

    // ── Dashboard ──
    Dashboard [label="Looker Studio\nRenewable Share Trend · Hourly Generation Mix",
               shape=component, style=filled, fillcolor="#FFF3CD", color="#B8860B"];

    // ── Orchestration ──
    Kestra [label="Kestra\nOrchestration · daily schedule",
            shape=ellipse, style="filled,dashed", fillcolor="#E8F8F5", color="#1D9E75"];

    // ── Infrastructure ──
    Terraform [label="Terraform\nInfrastructure as Code",
               shape=ellipse, style="filled,dashed", fillcolor="#F2F3F4", color="#717D7E"];

    // ── Main Pipeline Flow ──
    SMARD         -> Ingestion    [label="fetch"];
    Ingestion     -> GCS_Raw      [label="upload JSON"];
    GCS_Raw       -> Spark        [label="read"];
    Spark         -> GCS_Processed [label="write parquet"];
    GCS_Processed -> BigQuery     [label="load"];
    BigQuery      -> dbt          [label="transform"];
    dbt           -> Dashboard    [label="visualize"];

    // ── Kestra Orchestration ──
    Kestra -> Ingestion    [style=dashed, color="#1D9E75", label="trigger"];
    Kestra -> GCS_Raw      [style=dashed, color="#1D9E75"];
    Kestra -> GCS_Processed [style=dashed, color="#1D9E75"];
    Kestra -> dbt          [style=dashed, color="#1D9E75"];

    // ── Terraform Infra ──
    Terraform -> GCS_Raw   [style=dashed, color="#717D7E", label="provision"];
    Terraform -> BigQuery  [style=dashed, color="#717D7E"];
}